<%- include('partials/head') %>
<h2 style="text-align:center;font-weight:400;text-decoration:underline">Métricas e Estatísticas</h2>
<div class="metricas">
  <section class="card">
    <h3>Reservas feitas no dia</h3>
    <% const pc = s.total ? Math.round(s.comuns / s.total * 100) : 0; %>
    <div class="pizza" role="img" aria-label="<%= s.comuns %> reservas comuns e <%= s.vip %> VIP"
         style="<%= s.total ? `background: conic-gradient(#5b6bb5 0 ${pc}%, #2fe8d9 ${pc}% 100%)` : '' %>"></div>
    <p class="legenda">
      <span style="background:#5b6bb5"></span><%= s.comuns %> reservas comuns<br>
      <span style="background:#2fe8d9"></span><%= s.vip %> reservas VIP
    </p>
  </section>

  <section class="card">
    <h3>Atrações mais disputadas</h3>
    <% if (!s.rankingAtracoes || !s.rankingAtracoes.length) { %>
      <strong>Sem reservas hoje</strong>
    <% } else { %>
      <ol class="ranking">
        <% s.rankingAtracoes.slice(0, 3).forEach((r, i) => { %>
          <li>
            <span class="pos"><%= i + 1 %>º</span>
            <span class="nome"><%= r.nome %></span>
            <span class="num"><%= r.n %> reservas</span>
          </li>
        <% }) %>
      </ol>
    <% } %>
    <div class="trofeu"><img class="trofeu-img" src="Parque_Terror_Trofeu_Sombrio-E.png" alt="Trofeu Sombrio"></div>
  </section>

  <section class="card">
    <h3>Visitantes do dia</h3>
    <% if (!s.rankingVisitantes || !s.rankingVisitantes.length) { %>
      <strong>Sem reservas hoje</strong>
    <% } else { %>
      <ol class="ranking">
        <% s.rankingVisitantes.slice(0, 3).forEach((r, i) => { %>
          <li>
            <span class="pos"><%= i + 1 %>º</span>
            <span class="nome"><%= r.nome %></span>
            <span class="num"><%= r.n %> reservas</span>
          </li>
        <% }) %>
      </ol>
    <% } %>
    <div class="trofeu"><img class="trofeu-img" src="Parque_Terror_Trofeu_Dourado-E.png" alt="Trofeu Dourado"></div>
  </section>
</div>
<%- include('partials/foot') %>
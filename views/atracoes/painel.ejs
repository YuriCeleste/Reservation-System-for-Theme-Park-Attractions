<%- include('../partials/head') %>
<h2>Painel de Controle do Parque</h2>
<% if (msg) { %><p class="ok"><%= msg %></p><% } %>

<div class="card larga">
  <% linhas.forEach(a => { %>
    <article class="atr">
      <h3><%= a.nome %></h3>
      <p>Capacidade por sessão: <%= a.capacidade %></p>
      <p>Idade mínima: <%= a.idade_minima %> anos</p>
      <p>Possui fila VIP: <%= a.vip ? 'sim' : 'não' %></p>
      <p>Horários do dia:</p>

      <div class="horas">
        <% a.sessoes.forEach(s => { %>
          <div class="sessao-box">
            <strong><%= s.horario.replace(':', 'h') %></strong>
            <small><%= s.tamanho %> pessoa(s) na fila</small>

            <% if (s.estrutura.tamanho > 0) { %>
              <div class="proximos">
                <span class="rotulo-mini">próximos:</span>
                <% s.estrutura.nos.slice(0, 5).forEach((no, i) => { %>
                  <span class="nome-fila">
                    <%= i + 1 %>º <%= no.nome %><% if (no.vip) { %> <span class="estrela">★</span><% } %>
                  </span>
                <% }) %>
                <% if (s.estrutura.tamanho > 5) { %>
                  <span class="mais">+<%= s.estrutura.tamanho - 5 %></span>
                <% } %>
              </div>
            <% } else { %>
              <p class="fila-vazia-mini">Fila vazia</p>
            <% } %>

            <form method="post" action="/atracoes/<%= a.id %>/embarcar">
              <button class="pill" <%= s.tamanho === 0 ? 'disabled' : '' %>>EMBARCAR</button>
            </form>
          </div>
        <% }) %>
      </div>
    </article>
  <% }) %>
</div>

<%- include('../partials/foot') %>
<%- include('../partials/head') %>
<div class="card larga">
  <form method="get">
    <label>Visitante:
      <select name="visitante" onchange="this.form.submit()">
        <option value="">Selecione o visitante</option>
        <% visitantes.forEach(x => { %>
          <option value="<%= x.id %>" <%= v && v.id === x.id ? 'selected' : '' %>><%= x.nome %></option>
        <% }) %>
      </select>
    </label>
  </form>

  <% if (ok === '1') { %><p class="ok">Cadastro concluído! Escolha uma atração abaixo.</p><% } %>
  <% if (ok === 'fila') { %><p class="ok">Você entrou na fila.</p><% } %>
  <% if (ok === 'saiu') { %><p class="ok">Você saiu da fila.</p><% } %>
  <% if (ok === 'trocou') { %><p class="ok">Horário trocado.</p><% } %>
  <% if (erro) { %><p class="erro"><%= erro %></p><% } %>

  <% if (!v) { %>
    <p>Selecione um visitante para ver as filas, as atrações e o histórico.</p>
  <% } else { %>

    <h3>Posições da fila atualmente:</h3>
    <% if (!minhas.length) { %>
      <p>Você não está em nenhuma fila.</p>
    <% } else { %>
      <table>
        <tr>
          <th>Atração/Evento</th>
          <th>Horário</th>
          <th>Posição da fila</th>
          <th>Ações</th>
        </tr>
        <% minhas.forEach(m => { %>
          <tr>
            <td><%= m.atracao %></td>
            <td><%= m.horario.replace(':', 'h') %></td>
            <td><%= m.posicao %>ª posição</td>
            <td>
              <form method="post" action="/visitantes/sair-fila" style="display:inline">
                <input type="hidden" name="atracao_id" value="<%= m.atracao_id %>">
                <input type="hidden" name="horario" value="<%= m.horario %>">
                <button class="pill">SAIR</button>
              </form>
              <% if (m.outrosHorarios.length) { %>
                <form method="post" action="/visitantes/trocar-horario" style="display:inline">
                  <input type="hidden" name="atracao_id" value="<%= m.atracao_id %>">
                  <input type="hidden" name="horario_atual" value="<%= m.horario %>">
                  <select name="novo_horario" style="width:auto;display:inline-block">
                    <% m.outrosHorarios.forEach(h => { %>
                      <option value="<%= h %>"><%= h.replace(':', 'h') %></option>
                    <% }) %>
                  </select>
                  <button class="pill">TROCAR</button>
                </form>
              <% } %>
            </td>
          </tr>
        <% }) %>
      </table>
    <% } %>

    <h3>Atrações:</h3>
    <% atracoes.forEach(a => { %>
      <article class="atr">
        <h3><%= a.nome %></h3>
        <p>Idade mínima: <%= a.idade_minima %> anos</p>
        <p>Possui fila VIP: <%= a.vip ? 'sim' : 'não' %></p>
        <p>Horários disponíveis do dia:</p>
        <div class="horas">
          <% a.horas.forEach(h => { %>
            <form method="post" action="/visitantes/fila">
              <input type="hidden" name="atracao_id" value="<%= a.id %>">
              <input type="hidden" name="horario" value="<%= h.h %>">
              <strong><%= h.h.replace(':', 'h') %></strong>
              <small><%= h.n %> pessoas já estão na fila</small>
              <button class="pill" <%= (a.menor || h.ja || h.passou) ? 'disabled' : '' %>>
                <%= a.menor ? 'idade mínima não atingida' : h.ja ? 'visitante já está na fila' : h.passou ? 'horário encerrado' : 'entrar na fila' %>
              </button>
            </form>
          <% }) %>
        </div>
      </article>
    <% }) %>

    <h3>Histórico de atrações reservadas:</h3>
    <% if (!historico.length) { %><p>Nenhuma reserva ainda.</p><% } else { %>
      <table>
        <tr><th>Atração/Evento</th><th>Entrou na fila</th><th>Embarcou</th></tr>
        <% historico.forEach(h => { %>
          <tr>
            <td><%= h.atracao %></td>
            <td><%= fmt(h.entrou_em) %></td>
            <td><%= fmt(h.embarcou_em) %></td>
          </tr>
        <% }) %>
      </table>
    <% } %>

  <% } %>
</div>
<%- include('../partials/foot') %>